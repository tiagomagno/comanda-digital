# Database (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/dine"

# Fonte de dados para o script de migracao MySQL -> PostgreSQL
# (so necessario ao rodar prisma/migration-mysql-to-postgres/migrate.ts)
MYSQL_SOURCE_URL="mysql://root@localhost:3306/dine"

# Server
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=sua_chave_secreta_muito_forte_aqui_mude_em_producao
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads
